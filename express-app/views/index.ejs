<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <ul>
      <% menu.forEach((item) => { %>
        <li>
          <a href="<%= item.link %>"><%= item.name %></a>
        </li>
     <% }) %>
         </ul>
    <% if (type === "Admin") { %>
      <h1>Welcome Admin</h1>
    <% } else { %>
     <h1>Hello <%= text %></h1>
    <% } %>

    <img src="/images/img.png" alt="" />
    <img src="/images/img.png" alt="" />
    <img src="/images/img.png" alt="" />
    <img src="/images/img.png" alt="" />
    <script src="/js/common.js"></script>
  </body>
</html>
